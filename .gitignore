# Secrets
.env

# Node (site)
node_modules/
site/dist/

# Run outputs. Per-item JSONL is large but IS the scientific record: keep it
# out of git and archive it alongside each published leaderboard version
# (Zenodo, or an object store). Manifests are small and ARE tracked, so every
# published number stays traceable from the repository alone.
runs/*/*.jsonl
!runs/**/manifest.json

# NOTE: no `test_*` rule here. The previous repo ignored `test_*` at any depth,
# so anyone adding tests committed nothing and every extraction bug shipped.

# Tool caches
.ruff_cache/

# macOS
.DS_Store

# Generated worklists. `tools/ifeval_worklist.py` derives this from
# data/ifeval_uz.json in seconds, so committing it only guarantees a copy that
# drifts from its source: the version tracked here was produced before the
# apostrophe repair and disagreed with the dataset within a day.
ifeval_todo.csv
